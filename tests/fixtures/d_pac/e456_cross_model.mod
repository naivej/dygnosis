// inventory: d_pac_e456_cross_model
var y x z z2 v;
varexo ey ex ez ez2;
parameters phi psi k beta;
phi=.3; psi=.4; k=.5; beta=.9;
var_model(model_name=aux,eqtags=['Y','X']);
pac_model(model_name=p,auxiliary_model_name=aux,discount=beta);
pac_model(model_name=q,auxiliary_model_name=aux,discount=beta);
pac_target_info(p);
  target v;
  auxname_target_nonstationary v_ns;
  component y;
  auxname y_part;
  kind ll;
  component x;
  growth diff(x(-1));
  auxname x_part;
  kind dd;
end;
pac_target_info(q);
  target v;
  auxname_target_nonstationary q_ns;
  component y;
  auxname y_part;
  kind ll;
  component x;
  growth diff(x(-1));
  auxname q_xpart;
  kind dd;
end;
model;
  [name='Y'] y=phi*y(-1)+ey;
  [name='X'] diff(x)=psi*diff(x(-1))+ex;
  [name='V'] v=x+y;
  [name='P'] diff(z)=k*(pac_target_nonstationary(p)-z(-1))+psi*diff(z(-1))+pac_expectation(p)+ez;
  [name='Q'] diff(z2)=k*(pac_target_nonstationary(q)-z2(-1))+psi*diff(z2(-1))+pac_expectation(q)+ez2;
end;
