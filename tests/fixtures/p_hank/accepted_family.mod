// inventory: p_hank_accepted_family
var y, c;
varexo e1, e2;
parameters rho;
rho = 0.9;
heterogeneity_dimension d;
var(heterogeneity=d) yh;
varexo(heterogeneity=d) eh, eh1, eh2, eh3, eh4, eh5;
parameters(heterogeneity=d) ph;
model;
y = rho*y(-1) + e1 + SUM(yh);
c = y + e2;
end;
model(heterogeneity=d);
yh = ph*yh(-1) + eh ⟂ yh >= 0;
end;
shocks(heterogeneity=d);
var eh; stderr 0.01;
var eh1, eh2 = 0.01;
corr eh3, eh4 = 0.2;
var eh5 = 0.01;
end;
shocks(heterogeneity=d, overwrite);
var eh; stderr 0.02;
end;
shocks(overwrite, heterogeneity=d);
var eh; stderr 0.03;
end;
heterogeneity_load_steady_state(filename='ss.txt', variable=ss, tolf=1e-6);
heterogeneity_compute_steady_state;
heterogeneity_solve(truncation_horizon=50);
heterogeneity_simulate(irf=10) y c;