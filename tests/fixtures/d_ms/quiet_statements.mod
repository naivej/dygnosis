// inventory: d_ms_quiet_statements
// The MS-SBVAR `;` statements 7.1 accepts, one line each.
var y c k;
varexo e;
parameters alpha beta delta;
alpha = 0.36;
beta = 0.99;
delta = 0.025;
model;
c = alpha*y + beta*c(-1) + e;
y = beta*y(-1) + c;
k = delta*y;
end;
initval;
y = 0;
c = 0;
k = 0;
end;
shocks;
var e; stderr 0.1;
end;
ms_estimation(no_create_init, nlags=2);
ms_simulation(mh_replic=1000, drop=100, thinning_factor=2);
ms_compute_mdd(proposal_draws=1000, use_mean_center);
ms_compute_probabilities(filtered_probabilities, file_tag=probs);
ms_irf(horizon=10, parameter_uncertainty) y, c;
ms_forecast(regime=1, data_obs_nbr=10);
ms_variance_decomposition(no_error_bands, horizon=8);
markov_switching(chain=1, number_of_regimes=2, duration=2.5, parameters=[alpha, beta], number_of_lags=1);
markov_switching(chain=2, number_of_regimes=2, duration=1.5, restrictions=[[1, 2, 0.4]]);
svar(coefficients, chain=1, equations=[1 2]);
svar(variances, chain=2);
svar_global_identification_check;
sbvar;
sbvar(datafile=msdata, freq=4, initial_year=1959, final_year=2005, nlags=2);
conditional_forecast(periods=8, replic=100, conf_sig=0.9, parameter_set=calibration, controlled_varexo=(e));
plot_conditional_forecast y, c;
plot_conditional_forecast(periods=4) y;
data(file='x.csv', nobs=10, first_obs=1959Q1, last_obs=2005Q4);
data(series=c, xls_sheet=Sheet1, xls_range=A1:B10);
