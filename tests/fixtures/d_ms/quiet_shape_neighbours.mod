// inventory: quiet_shape_neighbours
// The accepted neighbours beside every swept shape: bare `sbvar;` / `ms_irf;` / `svar_global_identification_check;`, `foo.bar(init=1, init=2);` and `[aaa, bbb].prior(…)` as native lines, `duration=0`, `svar(equations=[1, 99])`, `data(series=nosuch);`, `equation 1, e;`, `upper_cholesky;` alone, and a legal `periods` / `values` row. 7.1 accepts every one, so no E001 may fire.
var y c k;
varexo e;
parameters alpha beta gamma;
alpha = 0.36;
beta = 0.99;
gamma = 0.5;
model;
c = alpha*y + beta*c(-1) + e;
y = beta*y(-1) + c;
k = y;
end;
initval;
y = 0;
c = 0;
k = 0;
end;
shocks;
var e; stderr 0.1;
end;
sbvar;
ms_irf;
svar_global_identification_check;
foo.bar(init=1, init=2);
[aaa, bbb].prior(shape=beta, mean=[0.5 0.5], stdev=0.1);
markov_switching(chain=1, number_of_regimes=2, duration=0, restrictions=[[1, 2, 0.5]]);
svar(coefficients, chain=1, equations=[1, 99]);
data(series=nosuch);
svar_identification;
exclusion constants;
exclusion lag 0;
equation 1, e;
upper_cholesky;
end;
conditional_forecast_paths;
var y;
periods 1 2 3;
values 0.1 0.2 0.3;
end;
