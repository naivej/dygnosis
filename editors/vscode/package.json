        "title": "Dygnosis: Diagnostics",
        "properties": {
          "dynare.diagnosticActions.ignore": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "description": "Offer Ignore this check in diagnostic quick fixes. Hidden checks can still be restored with Show or Show all."
          },
          "dynare.diagnosticActions.explain": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "description": "Offer Explain this check in diagnostic quick fixes. The Command Palette command remains available."
          }
        }
      },
      {
        "title": "Dygnosis: Diff",
        "properties": {
          "dynare.diff.layout": {
            "type": "string",
            "enum": [
              "auto",
              "sideBySide",
              "stacked"
            ],
            "default": "auto",
            "scope": "resource",
            "description": "Model Diff layout. Auto stacks Before and After in a narrow view."
          },
          "dynare.diff.defaultExpansion": {
            "type": "string",
            "enum": [
              "changes",
              "all",
              "none"
            ],
            "default": "changes",
            "scope": "resource",
            "description": "Initial section expansion in a new model Diff view."
          },
          "dynare.diff.defaultChangeKinds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "added",
                "removed",
                "changed",
                "unpaired"
              ]
            },
            "default": [
              "added",
              "removed",
              "changed",
              "unpaired"
            ],
            "scope": "resource",
            "description": "Change kinds initially shown in a new model Diff view. Empty hides all rows."
          },
          "dynare.diff.sections": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "symbols",
                "parameters",
                "aggregateEquations",
                "heterogeneousEquations",
                "shockSetup",
                "shockAnalysisSetup"
              ]
            },
            "default": [
              "symbols",
              "parameters",
              "aggregateEquations",
              "heterogeneousEquations",
              "shockSetup",
              "shockAnalysisSetup"
            ],
            "scope": "resource",
            "description": "Sections shown in model Diff. Empty hides all content."
          }
        }
      }
