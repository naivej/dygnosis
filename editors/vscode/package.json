{
  "name": "dygnosis",
  "displayName": "Dygnosis",
  "icon": "media/logo_s.png",
  "description": "Dynare language tooling for VS Code",
  "version": "0.11.0",
  "publisher": "dygnosis",
  "private": true,
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/naivej/dygnosis.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.102.0",
    "node": "^22.13.0 || >=24"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Read-only analysis is available. A workspace cannot choose the executable; project MCP setup requires trust.",
      "restrictedConfigurations": [
        "dynare.serverPath"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Grammar only on virtual filesystems. Native analysis requires a file-backed workspace."
    }
  },
  "activationEvents": [
    "onLanguage:dynare",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "check": "tsc -p . --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "npm run compile && node --test tests/*.test.cjs",
    "test:host": "npm run compile && node tests/run-host.cjs",
    "vscode:prepublish": "npm run check && npm run lint && npm run compile",
    "package:target": "node scripts/package.cjs",
    "verify:package": "node scripts/verify-package.cjs"
  },
  "contributes": {
    "languages": [
      {
        "id": "dynare",
        "aliases": [
          "Dynare",
          "dynare"
        ],
        "extensions": [
          ".mod",
          ".dyn",
          ".inc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dynare",
        "scopeName": "source.dynare",
        "path": "./syntaxes/dynare.tmLanguage.json"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "dygnosis",
        "label": "Dygnosis"
      }
    ],
    "commands": [
      {
        "command": "dygnosis.restartServer",
        "title": "Restart language server",
        "category": "Dygnosis"
      },
      {
        "command": "dygnosis.showOutput",
        "title": "Show Output",
        "category": "Dygnosis"
      },
      {
        "command": "dygnosis.openSettings",
        "title": "Open Settings",
        "category": "Dygnosis"
      },
      {
        "command": "dygnosis.editSettingsJson",
        "title": "Edit in settings.json",
        "category": "Dygnosis"
      },
      {
        "command": "dygnosis.showEffectiveModel",
        "title": "Show effective model",
        "category": "Dygnosis",
        "enablement": "dygnosis.modelContext",
        "icon": "$(open-preview)"
      },
      {
        "command": "dygnosis.treatAsRoot",
        "title": "Treat this file as a model root",
        "category": "Dygnosis",
        "enablement": "dygnosis.analysisDocument && resourceExtname =~ /\\.(mod|dyn)$/"
      },
      {
        "command": "dygnosis.goToEquation",
        "title": "Go to equation N",
        "category": "Dygnosis",
        "enablement": "dygnosis.analysisDocument",
        "icon": "$(list-ordered)"
      },
      {
        "command": "dygnosis.jumpToNamedEquation",
        "title": "Jump to named equation",
        "category": "Dygnosis",
        "enablement": "dygnosis.analysisDocument",
        "icon": "$(search)"
      },
      {
        "command": "dygnosis.chooseModelOwner",
        "title": "Choose model owner",
        "category": "Dygnosis",
        "enablement": "dygnosis.analysisDocument",
        "icon": "$(organization)"
      },
      {
        "command": "dygnosis.refreshModelView",
        "title": "Refresh model view",
        "category": "Dygnosis",
        "icon": "$(refresh)"
      },
      {
        "command": "dygnosis.explainDiagnostic",
        "title": "Explain a check",
        "category": "Dygnosis"
      },
      {
        "command": "dygnosis.showDiagnostic",
        "title": "Show a hidden check",
        "category": "Dygnosis"
      },
      {
        "command": "dygnosis.showAllDiagnostics",
        "title": "Show all hidden checks",
        "category": "Dygnosis"
      },
      {
        "command": "dygnosis.goToWrittenSource",
        "title": "Go to written source",
        "category": "Dygnosis",
        "icon": "$(go-to-file)",
        "enablement": "dygnosis.previewWrittenSource"
      },
      {
        "command": "dygnosis.showMacroOrigins",
        "title": "Show macro origins",
        "category": "Dygnosis",
        "icon": "$(list-tree)",
        "enablement": "dygnosis.previewMacroOrigins"
      },
      {
        "command": "dygnosis.refreshEffectiveModel",
        "title": "Refresh effective model",
        "category": "Dygnosis",
        "icon": "$(refresh)",
        "enablement": "dygnosis.effectivePreview"
      },
      {
        "command": "dygnosis.diffWith",
        "title": "Diff with…",
        "category": "Dygnosis",
        "enablement": "dygnosis.modelContext",
        "icon": "$(diff)"
      },
      {
        "category": "Dygnosis",
        "command": "dygnosis.setupProjectMcp",
        "title": "Set up MCP for this project",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dygnosis.showEffectiveModel",
          "when": "dygnosis.modelContext && dygnosis.toolbarActions",
          "group": "navigation"
        },
        {
          "command": "dygnosis.goToWrittenSource",
          "when": "resourceScheme == dygnosis-effective && dygnosis.effectivePreview && dygnosis.previewToolbarActions",
          "group": "navigation@1"
        },
        {
          "command": "dygnosis.showMacroOrigins",
          "when": "resourceScheme == dygnosis-effective && dygnosis.effectivePreview && dygnosis.previewToolbarActions",
          "group": "navigation@2"
        },
        {
          "command": "dygnosis.refreshEffectiveModel",
          "when": "resourceScheme == dygnosis-effective && dygnosis.effectivePreview && dygnosis.previewToolbarActions",
          "group": "navigation@3"
        },
        {
          "command": "dygnosis.diffWith",
          "when": "dygnosis.modelContext && dygnosis.toolbarActions",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "dygnosis.showEffectiveModel",
          "when": "dygnosis.modelContext && dygnosis.contextActions",
          "group": "navigation"
        },
        {
          "command": "dygnosis.goToWrittenSource",
          "when": "resourceScheme == dygnosis-effective && dygnosis.effectivePreview && dygnosis.previewContextActions",
          "group": "navigation@1"
        },
        {
          "command": "dygnosis.showMacroOrigins",
          "when": "resourceScheme == dygnosis-effective && dygnosis.effectivePreview && dygnosis.previewContextActions",
          "group": "navigation@2"
        },
        {
          "command": "dygnosis.refreshEffectiveModel",
          "when": "resourceScheme == dygnosis-effective && dygnosis.effectivePreview && dygnosis.previewContextActions",
          "group": "navigation@3"
        },
        {
          "command": "dygnosis.diffWith",
          "when": "dygnosis.modelContext && dygnosis.contextActions",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "dygnosis.showEffectiveModel",
          "when": "dygnosis.modelContext"
        },
        {
          "command": "dygnosis.treatAsRoot",
          "when": "dygnosis.analysisDocument && resourceExtname =~ /\\.(mod|dyn)$/"
        },
        {
          "command": "dygnosis.goToEquation",
          "when": "dygnosis.analysisDocument"
        },
        {
          "command": "dygnosis.jumpToNamedEquation",
          "when": "dygnosis.analysisDocument"
        },
        {
          "command": "dygnosis.chooseModelOwner",
          "when": "dygnosis.analysisDocument"
        },
        {
          "command": "dygnosis.goToWrittenSource",
          "when": "resourceScheme == dygnosis-effective && dygnosis.effectivePreview"
        },
        {
          "command": "dygnosis.showMacroOrigins",
          "when": "resourceScheme == dygnosis-effective && dygnosis.effectivePreview"
        },
        {
          "command": "dygnosis.refreshEffectiveModel",
          "when": "resourceScheme == dygnosis-effective && dygnosis.effectivePreview"
        },
        {
          "command": "dygnosis.diffWith",
          "when": "dygnosis.modelContext"
        }
      ],
      "view/title": [
        {
          "command": "dygnosis.goToEquation",
          "when": "view == dygnosis.model && dygnosis.equationNavigation",
          "group": "navigation@1"
        },
        {
          "command": "dygnosis.jumpToNamedEquation",
          "when": "view == dygnosis.model && dygnosis.equationNavigation",
          "group": "navigation@2"
        },
        {
          "command": "dygnosis.chooseModelOwner",
          "when": "view == dygnosis.model && dygnosis.includeOwners",
          "group": "navigation@3"
        },
        {
          "command": "dygnosis.refreshModelView",
          "when": "view == dygnosis.model",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": [
      {
        "title": "Dygnosis: Engine",
        "properties": {
          "dynare.serverPath": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "description": "Absolute path to a Dygnosis executable. Empty uses the binary included with the extension. Set only in user/machine settings."
          },
          "dynare.searchPaths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "scope": "resource",
            "description": "Additional include directories, resolved against the model's workspace folder or loose-file directory."
          },
          "dynare.formatIndent": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "tab"
                ]
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              }
            ],
            "default": "tab",
            "scope": "resource",
            "description": "Use a tab or 1–8 spaces for indentation."
          }
        }
      },
      {
        "title": "Dygnosis: Model overview",
        "properties": {
          "dynare.outline.sections": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "declarations",
                "blocks",
                "commands",
                "dimensions",
                "equations"
              ]
            },
            "uniqueItems": true,
            "default": [
              "declarations",
              "blocks",
              "commands",
              "dimensions",
              "equations"
            ],
            "scope": "resource",
            "description": "Sections shown in Outline, breadcrumbs and quick outline. Empty hides all sections."
          },
          "dynare.outline.equationNumbers": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "description": "Show Dygnosis equation numbers before transformation in Outline."
          },
          "dynare.statusBar.enabled": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "description": "Show aggregate model counts in the status bar for the active .mod or .dyn."
          },
          "dynare.statusBar.counts": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "endogenous",
                "exogenous",
                "equations"
              ]
            },
            "uniqueItems": true,
            "default": [
              "endogenous",
              "exogenous",
              "equations"
            ],
            "scope": "resource",
            "description": "Aggregate counts shown in the status bar, in this order. Empty hides the bar."
          },
          "dynare.modelView.sections": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "counts",
                "timing",
                "dimensions",
                "relatedFiles"
              ]
            },
            "uniqueItems": true,
            "default": [
              "counts",
              "timing",
              "dimensions",
              "relatedFiles"
            ],
            "scope": "resource",
            "description": "Sections shown in the Dynare model view. List order sets section order; empty hides its content."
          }
        }
      },
      {
        "title": "Dygnosis: Name details",
        "properties": {
          "dynare.nameDetails.longName": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "description": "Show written long_name in hover, completion and Outline."
          },
          "dynare.nameDetails.tex": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "description": "Show written TeX as literal text in hover, completion and Outline."
          }
        }
      },
      {
        "title": "Dygnosis: Value hints",
        "properties": {
          "dynare.parameterValueHints": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "description": "Show proven expression values at top-level assignments. Also respects native editor inlay-hint visibility."
          }
        }
      },
      {
        "title": "Dygnosis: Actions",
        "properties": {
          "dynare.editorActions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "toolbar",
                "contextMenu"
              ]
            },
            "uniqueItems": true,
            "default": [
              "toolbar",
              "contextMenu"
            ],
            "scope": "window",
            "description": "Locations for model actions. Commands remain in the Command Palette."
          },
          "dynare.codeLens.modelEquations": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "description": "Browse surviving equations at each safely mapped model opener. Numbers are before transformation. Also respects editor.codeLens."
          },
          "dynare.codeLens.declarationReferences": {
            "type": "boolean",
            "default": false,
            "scope": "resource",
            "description": "Offer native Find All References at declaration lines. Several names open a symbol picker; no usage count is shown."
          },
          "dynare.codeLens.effectiveModel": {
            "type": "boolean",
            "default": false,
            "scope": "resource",
            "description": "Offer Show effective model at the first safely mapped model opener. Also respects editor.codeLens."
          }
        }
      },
      {
